{
  "format": "smaltfl-datamodel/1",
  "kinds": {
    "org_unit": { "icon": "org", "one": "unit", "many": "units" },
    "person": { "icon": "person", "one": "person", "many": "people" },
    "application": { "icon": "app", "one": "application", "many": "applications" },
    "platform": { "icon": "platform", "one": "platform", "many": "platforms" },
    "control": { "icon": "control", "one": "control", "many": "controls" }
  },
  "datasets": {
    "hr_org_units": { "short": "Org units" },
    "hr_people": { "short": "People" },
    "cmdb_apps": { "short": "CMDB" },
    "findings": { "short": "Findings", "kind": "control" },
    "tls": { "short": "TLS", "kind": "control" },
    "waf": { "short": "WAF", "kind": "control" },
    "pentest_schedule": { "short": "Pen tests", "kind": "control" },
    "encryption": { "short": "Encryption", "kind": "control" },
    "key_rotation": { "short": "Key rotation", "kind": "control" },
    "backup_jobs": { "short": "Backups", "kind": "control" },
    "dr_exercises": { "short": "DR exercises", "kind": "control" },
    "mfa": { "short": "MFA", "kind": "control" },
    "access_reviews": { "short": "Access reviews", "kind": "control" },
    "logging_coverage": { "short": "Logging", "kind": "control" },
    "privileged_vault": { "short": "Vault", "kind": "control" },
