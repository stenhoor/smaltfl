    "platform_links": { "short": "Platform links", "kind": "platform" },
    "control_catalog": { "short": "Control catalogue" },
    "control_requirements": { "short": "Requirements", "kind": "control" },
    "exceptions": { "short": "Exceptions", "kind": "control" }
  },
  "joins": [
    { "from": "hr_people", "col": "org_unit_id", "to": "hr_org_units", "toCol": "org_unit_id", "rel": "works in" },
    { "from": "exceptions", "col": "approver_id", "to": "hr_people", "toCol": "person_id", "rel": "approved by" },
    { "from": "cloud_assets", "col": "app_tag", "to": "cmdb_apps", "toCol": "app_id", "rel": "about" },
    { "from": "control_catalog", "col": "depends_on", "to": "control_catalog", "toCol": "control_id", "rel": "depends on" }
  ],
  "evidence": {
    "kind": "control",
    "rel": "evidence for",
    "checks": "checks",
    "datasets": {
      "tls": { "id": "tls", "name": "TLS on exposed endpoints" },
      "waf": { "id": "waf", "name": "Web application firewall" },
      "pentest_schedule": { "id": "pentest", "name": "Yearly penetration test" },
      "encryption": { "id": "encryption", "name": "Encryption at rest" },
      "key_rotation": { "id": "key_rotation", "name": "Yearly key rotation" },
      "backup_jobs": { "id": "backup", "name": "Backups within the recovery point" },
      "dr_exercises": { "id": "dr_exercise", "name": "Yearly disaster-recovery exercise" },
      "findings": { "id": "vuln_sla", "name": "Vulnerabilities fixed within their SLA" },
      "mfa": { "id": "mfa", "name": "MFA enforced" },
      "access_reviews": { "id": "access_review", "name": "Quarterly access review" },
      "logging_coverage": { "id": "logging", "name": "Central logging" },
      "privileged_vault": { "id": "privileged_access", "name": "Privileged accounts vaulted" },
      "edr_coverage": { "id": "edr", "name": "Endpoint detection" },
