          "classification": "internal",
          "required": true
        },
        {
          "name": "exception_id",
          "type": "TEXT",
          "description": "The exception in force",
          "classification": "internal"
        },
        {
          "name": "platform",
          "type": "TEXT",
          "description": "The platform it rests on",
          "classification": "internal"
        },
        {
          "name": "as_of",
