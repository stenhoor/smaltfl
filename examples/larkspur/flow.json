{
  "smaltfl": 4,
  "id": "larkspur",
  "name": "Larkspur estate",
  "description": "A fictional financial-services group's control posture as its systems export it each day (ADR 0020): the organisation and its leaders from HR, about 2,400 applications from the CMDB, the cloud inventory, 46 shared platforms, a catalogue of 14 controls mapped to the frameworks, the risk register, the findings ledger and twelve evidence feeds. The bronze notebook judges every feed as it arrives; the silver notebooks conform the organisation, the applications and the evidence, and tell the posture a person reads. A synthetic dataset: no real company or person is its subject.",
  "parameters": [
    {
      "name": "day",
      "type": "text",
      "default": null
    }
  ],
  "calendar": {
    "base": "us",
    "zone": "UTC",
    "days": [
      {
        "name": "Patch Tuesday",
        "short": "Patch Tue",
        "weekday": "tue",
        "between": [
          8,
          14
        ]
      }
    ]
  },
  "flows": [
    "hr/flow.json",
    "inventory/flow.json",
    "feeds/flow.json",
    "applications/flow.json"
  ],
  "sources": [
    {
      "id": "control_catalog",
      "table": "control_catalog_file",
      "description": "The GRC tool's control catalogue: each control's CSF 2.0 function and category, weight and cadence, which applications it applies to, what it depends on, what compensates for it and the kind of platform that provides it"
    },
    {
      "id": "control_requirements",
      "table": "control_requirements_file",
      "description": "Each control mapped to framework requirements (NIST CSF 2.0, ISO/IEC 27001:2022, PCI DSS v4.0.1, SOC 2), with how the two relate"
    },
    {
      "id": "exceptions",
      "table": "exceptions_file",
      "description": "The risk register: every version of every exception, with its approver, reason, validity and status that day"
    }
  ],
  "notebooks": [
    "bronze.nb.ts",
    "evidence.nb.ts",
    "posture.nb.ts",
    "product.nb.ts"
  ],
  "ontology": {
    "import": [
      "./ontology.json"
    ]
  },
  "policies": {
    "principals": [
      {
        "id": "owner",
        "name": "Owner",
        "role": "Owns the flow",
        "owner": true
      },
      {
        "id": "ciso",
        "name": "Sloane Marsden",
        "role": "Security lead"
      }
    ],
    "groups": [],
    "rules": [
      {
        "id": "leads",
        "kind": "action",
        "name": "The security lead may decide",
        "action": "smaltfl:decide",
        "for": [
          "ciso"
        ]
      }
    ]
  },
  "contracts": {
    "dim_org": {
      "id": "control-posture/dim_org",
      "version": "1.0.0",
      "status": "active",
      "description": {
        "purpose": "The organisation, one row a unit, for every roll-up",
        "limitations": "Held on a day the organisation’s chain loops or stops short; the last day published stands",
        "usage": "Join an application’s owner unit or a level’s unit by org_unit_id"
      },
      "columns": [
        {
          "name": "org_unit_id",
          "type": "TEXT",
          "description": "The unit; UNASSIGNED for applications whose chain doesn’t resolve",
          "classification": "internal",
