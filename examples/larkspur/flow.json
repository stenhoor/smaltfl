          "key": true
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "Its name",
          "classification": "internal",
          "required": true
        },
        {
          "name": "level",
          "type": "TEXT",
          "description": "Its level",
          "classification": "internal",
          "required": true,
          "values": [
            "group",
            "segment",
            "business_unit",
            "department",
            "team",
            "unassigned"
          ]
        },
        {
          "name": "parent_id",
          "type": "TEXT",
          "description": "The unit above",
          "classification": "internal"
        },
        {
          "name": "depth",
          "type": "INTEGER",
          "description": "Levels below the group",
          "classification": "internal"
        },
        {
          "name": "path",
          "type": "TEXT",
          "description": "Its path from the segment down",
          "classification": "internal",
          "required": true
        },
        {
          "name": "segment_id",
          "type": "TEXT",
          "description": "Its segment",
          "classification": "internal"
        },
        {
          "name": "business_unit_id",
          "type": "TEXT",
          "description": "Its business unit",
          "classification": "internal"
        },
        {
          "name": "department_id",
          "type": "TEXT",
          "description": "Its department",
          "classification": "internal"
        },
        {
          "name": "team_id",
          "type": "TEXT",
          "description": "The team, where it is one",
          "classification": "internal"
        },
        {
          "name": "leader_id",
          "type": "TEXT",
          "description": "The leader it answers to",
          "classification": "confidential"
        },
        {
          "name": "leader_how",
          "type": "TEXT",
          "description": "Its own leader, acting, or inherited from above",
          "classification": "internal",
          "values": [
            "leader",
            "acting",
            "inherited"
          ]
        },
        {
          "name": "leader_name",
          "type": "TEXT",
          "description": "The leader’s name",
          "classification": "confidential"
        },
        {
          "name": "segment_leader_id",
          "type": "TEXT",
          "description": "The segment’s leader",
          "classification": "confidential"
        },
        {
          "name": "business_unit_leader_id",
          "type": "TEXT",
          "description": "The business unit’s leader",
          "classification": "confidential"
        },
        {
          "name": "department_leader_id",
          "type": "TEXT",
          "description": "The department’s leader",
          "classification": "confidential"
        }
      ],
      "sla": {
        "frequency": "daily",
        "availableBy": "07:00 UTC",
        "retention": "13 months"
      }
    },
