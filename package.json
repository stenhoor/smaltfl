{
  "name": "smaltfl",
  "version": "0.1.0",
  "private": true,
  "description": "Data pipelines for smaltdb: flows built visually, run in the browser, hashed all the way through",
  "keywords": [
    "smaltdb",
    "pipelines",
    "data-engineering",
    "lineage",
    "reproducibility"
  ],
  "license": "MIT",
  "homepage": "https://github.com/stenhoor/smaltfl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltfl.git"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltfl/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./notebook": {
      "types": "./dist/notebook.d.ts",
      "default": "./dist/notebook.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/fetch-packed.mjs --check && tsc -p tsconfig.json",
    "test": "node scripts/fetch-packed.mjs --check && NODE_OPTIONS=--max-semi-space-size=64 vitest run",
    "test:slow": "node scripts/fetch-packed.mjs --check && NODE_OPTIONS=--max-semi-space-size=64 SMALTFL_SLOW=1 vitest run",
    "test:isolated": "node scripts/fetch-packed.mjs --check && NODE_OPTIONS=--max-semi-space-size=64 SMALTFL_ISOLATE=1 vitest run",
    "check": "npm run typecheck && npm test",
    "bench": "node scripts/fetch-packed.mjs --check && SMALTFL_BENCH=1 vitest run",
    "rules:sync": "node scripts/rules-sync.mjs",
    "build:app": "node scripts/fetch-packed.mjs --check && node scripts/build-app.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
